{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=HapagPortalDb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_USER_SECRETS_OR_ENV_VARIABLE",
    "Issuer": "HapagPortal",
    "Audience": "HapagPortalClients",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "https://portal.hapag-lloyd.cl",
      "https://hapag-portal-production.up.railway.app"
    ]
  },
  "Payments": {
    "Webhooks": {
      "Enabled": false,
      "Khipu": { "Secret": "" },
      "BancoChile": { "Secret": "", "SigningKey": "" }
    },
    "Outbox": {
      "Enabled": true,
      "IntervalSeconds": 5,
      "BatchSize": 50
    }
  },
  "Security": {
    "EnforceHttps": true
  },
  "AccessGrants": {
    "ExpiryEnabled": true,
    "ExpiryIntervalMinutes": 5
  },
  "WarehouseChanges": {
    "BatchProcessingEnabled": true,
    "BatchIntervalSeconds": 5,
    "BatchChunkSize": 50
  },
  "Documents": {
    "StorageContainer": "shipment-documents",
    "RetentionYears": 10,
    "TransshipmentRecipient": "Auto",
    "UmarEmail": "",
    "ResponsibilityLetterValidityDays": 0,
    "IssuerChile": "Hapag-Lloyd Chile SpA",
    "IssuerBolivia": "Hapag-Lloyd Bolivia S.R.L."
  },
  "Integrations": {
    "Nexus": { "Mode": "Dummy", "BaseUrl": "", "TimeoutSeconds": 10, "TotalTimeoutSeconds": 30, "RetryBaseDelayMs": 2000 },
    "Fis": { "Mode": "Dummy", "BaseUrl": "", "TimeoutSeconds": 10, "TotalTimeoutSeconds": 30, "RetryBaseDelayMs": 2000 },
    "Khipu": { "Mode": "Dummy", "BaseUrl": "", "TimeoutSeconds": 10, "TotalTimeoutSeconds": 30, "RetryBaseDelayMs": 2000 },
    "BancoChile": { "Mode": "Dummy", "BaseUrl": "", "TimeoutSeconds": 10, "TotalTimeoutSeconds": 30, "RetryBaseDelayMs": 2000 },
    "Santander": { "Mode": "Dummy", "BaseUrl": "", "TimeoutSeconds": 10, "TotalTimeoutSeconds": 30, "RetryBaseDelayMs": 2000 },
    "Bci": { "Mode": "Dummy", "BaseUrl": "", "TimeoutSeconds": 10, "TotalTimeoutSeconds": 30, "RetryBaseDelayMs": 2000 },
    "DbNet": { "Mode": "Dummy", "BaseUrl": "", "TimeoutSeconds": 10, "TotalTimeoutSeconds": 30, "RetryBaseDelayMs": 2000 },
    "Signature": { "Mode": "Dummy", "BaseUrl": "", "TimeoutSeconds": 10, "TotalTimeoutSeconds": 30, "RetryBaseDelayMs": 2000 },
    "Storage": { "Mode": "Dummy", "BaseUrl": "", "LocalPath": "", "TimeoutSeconds": 10, "TotalTimeoutSeconds": 30, "RetryBaseDelayMs": 2000 },
    "Tracking": { "Mode": "Dummy", "BaseUrl": "", "TimeoutSeconds": 10, "TotalTimeoutSeconds": 30, "RetryBaseDelayMs": 2000 },
    "Tatc": { "Mode": "Dummy", "BaseUrl": "", "TimeoutSeconds": 10, "TotalTimeoutSeconds": 30, "RetryBaseDelayMs": 2000, "CacheSeconds": 30 }
  },
  "Assistant": {
    "Mode": "Rules",
    "SessionIdleMinutes": 30,
    "RateLimitPerMinute": 20,
    "ResponseTargetMs": 3000,
    "Ollama": { "BaseUrl": "", "Model": "phi3.5", "TimeoutSeconds": 20 }
  },
  "PortalLinks": {
    "Dispute": {
      "CL": "https://www.hapag-lloyd.com/",
      "BO": "https://www.hapag-lloyd.com/"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
